# Conexión a PostgreSQL del Observatorio de la Economía del Cuidado.
# Copiar a .env y ajustar. El archivo .env no se versiona.
#
#   cp .env.example .env
#
# Los nombres POSTGRES_* son los que espera la imagen oficial de postgres,
# así que docker-compose los puede pasar tal cual al contenedor.

POSTGRES_USER=observatorio
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=cuidados
POSTGRES_PORT=5432

# Contraseña del rol `tablero`, el usuario de SOLO LECTURA con el que se conecta
# el tablero (ver sql/02_usuario_tablero.sql). No es el administrador: solo puede
# hacer SELECT sobre el esquema indicadores. Se aplica al crear la base, así que
# cambiarla exige `docker compose down -v`.
TABLERO_PASSWORD=cambiar_esta_clave_tambien

# Host al que se conecta el cliente.
#   localhost          -> desde tu máquina (psql, el tablero, un notebook)
#   postgres           -> desde otro contenedor de docker-compose
POSTGRES_HOST=localhost
